generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Base fields
// id        String   @id @default(cuid())
// createdAt DateTime @default(now())
// updatedAt DateTime @updatedAt

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
}

// Modo da rodada. STANDARD = venda a preço fixo (pastel, fluxo original).
// PIZZA_SPLIT = racha de pizza (rateio do custo real, descoberto no fim).
// GENERAL_SPLIT = racha geral (uma compra, valor total conhecido, dividido entre quem entra).
enum EventKind {
  STANDARD
  PIZZA_SPLIT
  GENERAL_SPLIT
}

// Como o valor por pessoa é definido num racha geral. DYNAMIC = cai a cada entrada
// e só fecha quando o organizador fecha. TARGET = já nasce definido (total / alvo).
enum SplitMode {
  DYNAMIC
  TARGET
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  WAITING_PAYMENT
  PAID
  UNPAID
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

model User {
  id             String               @id @default(cuid())
  name           String
  surname        String
  email          String               @unique
  passwordHash   String?
  role           Role                 @default(USER)
  // F3.7 — soft-disable (conta desativada não loga e tem sessões revogadas)
  disabledAt     DateTime?
  // F4.1 — identidade enriquecida (todos opcionais)
  displayName    String? // "apelido" usado nas telas sociais
  avatarUrl      String? // URL pública/assinada do avatar no Supabase Storage
  bio            String?
  team           String? // "time/setor" (F4.1 RN1)
  orders         Order[]
  createdTypes   Type[]
  createdEvents  Event[]
  refreshTokens  RefreshToken[]
  // F3.1 — vínculos de acesso a eventos (organizer)
  eventLinks     EventOrganizer[]     @relation("OrganizerLinks")
  grantedLinks   EventOrganizer[]     @relation("GrantedLinks")
  // F3.5 — tokens de redefinição de senha
  passwordResets PasswordResetToken[]
  // F3.1/F3.2/F3.7 — ações de auditoria que este usuário executou
  auditActions   AuditLog[]           @relation("AuditActor")
  // Frente 5 — temporadas em que este usuário foi campeão.
  rankingTitles  RankingSeason[]      @relation("RankingChampion")
  createdAt      DateTime             @default(now())
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Type {
  id              String   @id @default(cuid())
  name            String
  description     String?
  createdByUserId String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  createdByUser User    @relation(fields: [createdByUserId], references: [id])
  events        Event[]
  items         Item[]

  @@index([createdByUserId])
}

model Event {
  id              String      @id @default(cuid())
  name            String
  // Racha de pizza não usa Type — por isso `typeId` é opcional. O pastel
  // (STANDARD) continua exigindo um Type, validado no service por `kind`.
  typeId          String?
  kind            EventKind   @default(STANDARD)
  startsAt        DateTime
  endsAt          DateTime
  status          EventStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime    @default(now())
  // Parte 2 — marca que o e-mail de "rodada começou" já foi enviado (idempotência do cron).
  startNotifiedAt DateTime?
  // Limite de itens por pedido nesta rodada (configurável por evento; ainda sem CRUD).
  maxItemsPerOrder Int        @default(15)

  // ── Racha de pizza (PIZZA_SPLIT): config do motor + PIX (opcionais p/ STANDARD) ──
  maxFlavorsPerOrder Int?     // nº de sabores por pessoa (default 3 na UI; 2..10)
  slicesPerPizza     Int?     // fatias por pizza grande (motor)
  avgLargePizzaPrice Decimal? // média do valor da pizza grande (motor)
  pixKey             String?  // PIX da rodada (obrigatório no racha e na criação de encomenda)
  pixQrUrl           String?

  // ── Encomenda (STANDARD): taxa de serviço por pedido, opcional ──
  hasServiceFee     Boolean  @default(false)
  serviceFeePercent Decimal? // percentual sobre o subtotal do pedido (10 = 10%)

  // ── Custo real + evidência + ciclo de vida derivado (RP9/RP10) ──
  actualTotalCost  Decimal?
  costEvidenceUrl  String?
  costRegisteredAt DateTime?
  choicesLockedAt  DateTime?

  // onDelete: Restrict explícito — mantém a FK existente (não vira SET NULL ao
  // tornar `typeId` opcional). Evita drift de migração e preserva o comportamento.
  type          Type?            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  createdByUser User             @relation(fields: [createdByUserId], references: [id])
  orders        Order[]
  organizers    EventOrganizer[] // F3.1 — quem pode gerenciar este evento
  flavors       Flavor[] // sabores extras deste evento (eventId preenchido)
  generalSplit  GeneralSplit? // racha geral (GENERAL_SPLIT): config + estado
  goal          EventGoal? // meta de valor (só encomenda; 1:1)

  @@index([typeId])
  @@index([createdByUserId])
}

// Meta de valor da encomenda (1:1 com a rodada). Tabela própria porque nome e
// alvo só existem juntos, e porque a linha é travada (FOR UPDATE) na detecção
// de "meta atingida" durante a transação do pedido.
model EventGoal {
  id                String    @id @default(cuid())
  eventId           String    @unique
  name              String
  targetAmountCents Int
  reachedAt         DateTime?
  version           Int       @default(0)
  createdAt         DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Racha geral (GENERAL_SPLIT) — uma linha por evento. Fica fora de `Event` porque
// estes campos só existem juntos e porque esta linha é o ponto de serialização
// (SELECT ... FOR UPDATE) de toda escrita do racha.
model GeneralSplit {
  id                 String    @id @default(cuid())
  eventId            String    @unique
  // O que vai ser comprado, do jeito que o criador escreveu ("Cento de salgado").
  purchaseName       String
  totalAmountCents   Int
  mode               SplitMode
  // Só no TARGET: quantas pessoas devem compor o racha (>= 2). NULL no DYNAMIC.
  targetParticipants Int?
  // Agregados derivados de Order (cache do UPDATE condicional; ver plano 02).
  participantCount   Int       @default(0)
  pinnedBps          Int       @default(0)
  // Token de concorrência otimista: sobe 1 a cada escrita aceita.
  version            Int       @default(0)
  // TARGET: alcançou o alvo. DYNAMIC: sempre NULL.
  completedAt        DateTime?
  // Fechado pelo organizador: a partir daqui todo amountDueCents está congelado.
  settledAt          DateTime?
  createdAt          DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Item {
  id        String   @id @default(cuid())
  typeId    String
  name      String
  price     Decimal
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  // Agregado DERIVADO (cache) de unidades já pedidas, recalculado na criação de
  // rodada. Serve só para ordenar a vitrine; a verdade continua em OrderItem.
  orderCount Int     @default(0)

  type       Type        @relation(fields: [typeId], references: [id])
  orderItems OrderItem[]

  @@index([typeId])
  // Sustenta o 2º nível da ordenação do catálogo de uma rodada.
  @@index([typeId, orderCount(sort: Desc)])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  eventId       String
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(WAITING_PAYMENT)
  createdAt     DateTime      @default(now())
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  // Parte 2 — entrega do pedido (status DELIVERED).
  deliveredAt   DateTime?
  // ── Racha de pizza: Order = participação (1 por usuário/evento). `createdAt`
  //    governa a janela de edição de 10 min. ──
  slicesWanted  Int?     // "quantas fatias você geralmente come" (motor)
  amountDue     Decimal? // valor real após o rateio igualitário (snapshot no custo)
  // Encomenda — taxa congelada no pedido (como o `unitPrice` do OrderItem):
  // `serviceFee` são os reais cobrados, `serviceFeePercent` é só o rótulo do recibo.
  serviceFee        Decimal?
  serviceFeePercent Decimal?

  // Encomenda — snapshot: este pedido compõe a meta da rodada? O default false é o
  // backfill correto (nenhuma rodada tinha meta) e cobre o ramo do racha.
  countsTowardGoal Boolean @default(false)

  // ── Racha geral: participação. `sharePercentBps` NULL = flutuante (divide o
  //    que sobra). `amountDueCents` NULL = ainda não há valor devido. ──
  sharePercentBps Int?
  amountDueCents  Int?
  // Protege POST duplicado (toque duplo / retry de rede) na entrada do racha.
  idempotencyKey  String? @unique

  user        User             @relation(fields: [userId], references: [id])
  event       Event            @relation(fields: [eventId], references: [id])
  orderItems  OrderItem[]
  flavorVotes OrderFlavor[] // votos de sabor (racha)
  preferences OrderPreference[] // respostas do formulário (racha)

  @@index([userId])
  @@index([eventId, createdAt])
  // Histórico do usuário por item: filtra Order por (userId, status) no join.
  @@index([userId, status])
  // Frente 5 — ranking filtra por (status, createdAt); prêmio por (paymentStatus, createdAt).
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  // Meta de valor — soma os pedidos que compõem a meta de uma rodada.
  @@index([eventId, countsTowardGoal, status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  itemId    String
  quantity  Int
  unitPrice Decimal
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@index([itemId])
}

// RP2 — catálogo de sabores do racha de pizza (sem preço). `eventId = null` é um
// sabor padrão global (gerido por ADMIN); preenchido = extra de um evento (gerido
// por quem cuida do evento). `isSweet` separa doces de salgados na UI/dashboard.
model Flavor {
  id              String   @id @default(cuid())
  name            String
  isSweet         Boolean  @default(false)
  eventId         String? // null = padrão global; preenchido = extra do evento
  createdByUserId String? // quem cadastrou (auditoria leve; sem FK)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  event Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes OrderFlavor[]

  @@index([eventId])
}

// RP4 — perguntas sim/não do formulário de preferências (seedadas). `key` dá a
// semântica usada pelo motor para virar sugestão no dashboard (ex.: "beverage").
model PreferenceQuestion {
  id        String   @id @default(cuid())
  key       String   @unique
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  answers OrderPreference[]
}

// RP5 — voto de sabor ("topo esse"). Alimenta "mais pedidos"; não é compra.
model OrderFlavor {
  id       String @id @default(cuid())
  orderId  String
  flavorId String

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flavor Flavor @relation(fields: [flavorId], references: [id])

  @@unique([orderId, flavorId])
  @@index([orderId])
  @@index([flavorId])
}

// RP4 — resposta sim/não de um participante a uma pergunta seedada.
model OrderPreference {
  id         String  @id @default(cuid())
  orderId    String
  questionId String
  answer     Boolean

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  question PreferenceQuestion @relation(fields: [questionId], references: [id])

  @@unique([orderId, questionId])
  @@index([orderId])
}

// F3.1/F3.8 — acesso explícito de um ORGANIZER a um evento.
// Padrão: o evento que ele criou; pode ganhar acesso ao ser convidado.
model EventOrganizer {
  id              String   @id @default(cuid())
  eventId         String
  userId          String
  createdByUserId String? // quem concedeu o vínculo (auditoria)
  createdAt       DateTime @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation("OrganizerLinks", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("GrantedLinks", fields: [createdByUserId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

// F3.5 — redefinição de senha ("esqueci a senha"). Guarda só o hash do token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// F3.1 RN10 / F3.2 / F3.7 — auditoria mínima de ações sensíveis.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String // quem fez
  action    String // EVENT_ORGANIZER_INVITE | EVENT_ORGANIZER_REMOVE | USER_STATUS_CHANGE | USER_PASSWORD_RESET
  targetId  String? // usuário/recurso afetado
  metadata  Json? // de→para, eventId, etc.
  createdAt DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetId])
}

// Frente 5 — temporada do ranking fechada no dia 1º. Os campos `champion*` são
// SNAPSHOT: o apelido e o avatar são os do momento do fechamento.
model RankingSeason {
  id                  String   @id @default(cuid())
  period              String   @unique // 'YYYY-MM' no fuso America/Sao_Paulo
  closedAt            DateTime
  championUserId      String?
  championDisplayName String?
  championAvatarUrl   String?
  championPoints      Int      @default(0)
  participants        Int      @default(0)
  // Prêmio vigente no instante do fechamento (registro; não é promessa de pagamento).
  prizeAmountCents    Int?
  createdAt           DateTime @default(now())

  championUser User? @relation("RankingChampion", fields: [championUserId], references: [id])

  @@index([championUserId])
}
