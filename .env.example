# ─────────────────────────────────────────────────────────────
# Saboores Backend — exemplo de variáveis de ambiente
# Copie para `.env` e ajuste os valores. (valores abaixo são fictícios)
# ─────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ── Banco (obrigatório) ──────────────────────────────────────
# String de conexão do Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saboores?schema=public"

# ── Auth / JWT (obrigatório) ─────────────────────────────────
# Troque por uma string longa e aleatória.
JWT_SECRET="troque-por-uma-string-bem-longa-e-aleatoria"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# E-mails que viram ADMIN ao se registrar (separados por vírgula).
ADMIN_EMAILS="admin@example.com"

# Origens liberadas no CORS (vazio = libera tudo; use só em dev).
CORS_ORIGIN=""
# Força o atributo Secure do cookie (default: liga em produção).
# COOKIE_SECURE=false

# ── E-mail transacional — Gmail SMTP (transporte ATIVO) ──────
# Não exige domínio próprio: gere uma "App Password" na sua conta Google
# (Conta Google → Segurança → Verificação em 2 etapas → Senhas de app).
GMAIL_USER="sua-conta@gmail.com"
GMAIL_APP_PASSWORD="aaaa bbbb cccc dddd"
EMAIL_FROM_NAME="Saboores"
# Base do frontend p/ montar links nos e-mails (ex.: reset de senha).
APP_URL="http://localhost:5173"

# ── E-mail transacional — Resend (alternativo, INATIVO) ──────
# Só vale com domínio verificado no Resend. Para reativar, ver
# src/services/email.service.ts (trocar o provider).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="Saboores <no-reply@example.com>"

# ── Avatar + evidência de custo (Supabase Storage) — opcional ─
# Sem isto, os uploads retornam erro claro; o resto funciona.
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
# SUPABASE_AVATAR_BUCKET="avatars"
# Bucket (público) da evidência de custo do racha de pizza.
# SUPABASE_EVENT_EVIDENCE_BUCKET="event-evidence"

# ── Jobs / cron (notificações) ───────────────────────────────
# Em dev, deixe "false" para não disparar o cron de "nova rodada".
JOBS_ENABLED=false
NOTIFY_ROUNDS_CRON="0 */3 * * *"

# ── Racha de pizza — defaults do motor de cálculo ────────────
# Pré-preenchem a criação da rodada; cada rodada pode sobrescrever.
DEFAULT_LARGE_PIZZA_PRICE=60
DEFAULT_SLICES_PER_PIZZA=8

# ── Ranking por temporada + prêmio ───────────────────────────
# Conta dona das rodadas de encomenda que geram o lucro do prêmio.
RANKING_PRIZE_OWNER_EMAIL="vitor.rodrigues@vertrau.capital"
# Fração do lucro que vira prêmio (0 a 1). Não aparece na API nem na tela.
RANKING_PRIZE_SHARE=0.3
# Fechamento da temporada: 00:05 do dia 4 (America/Sao_Paulo), após a carência.
RANKING_SEASON_CRON="5 0 4 * *"
# Carência antes de congelar o campeão, em horas contadas do fim do mês (decisão 16).
RANKING_SEASON_GRACE_HOURS=72
